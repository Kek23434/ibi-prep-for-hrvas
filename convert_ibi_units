import os
import sys


def convert_ibi_ms_to_s(directory):
    """Convert IBI text files (one value per line, in ms) to seconds.

    Writes <name>_in_seconds.txt next to each file. Files that have already
    been converted are skipped, so the script is safe to run more than once.
    """
    for filename in os.listdir(directory):
        if filename.endswith(".txt") and not filename.endswith("_in_seconds.txt"):
            file_path = os.path.join(directory, filename)
            with open(file_path, "r") as f:
                data = [line.strip() for line in f if line.strip()]
            data_in_seconds = [float(x) / 1000 for x in data]
            out_path = os.path.splitext(file_path)[0] + "_in_seconds.txt"
            with open(out_path, "w") as f:
                for value in data_in_seconds:
                    f.write(f"{value}\n")


if __name__ == "__main__":
    # Usage: python convert_ibi_units.py <folder_with_ibi_txt_files>
    convert_ibi_ms_to_s(sys.argv[1])
